+// Stable, non-reversible identifier for an email so log lines can be tied to a
+// sign-up attempt without writing the address itself to the logs.
+function emailHash(email: string): string {
+  return createHash('sha256').update(email.trim().toLowerCase()).digest('hex').slice(0, 16);
+}
